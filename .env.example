# MongoDB connection string (required)
MONGODB_URI=mongodb://127.0.0.1:27017/connectrix

# Auth secrets (required in production; generate with: openssl rand -base64 32)
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Public base URL of the app (used for email links)
NEXTAUTH_URL=http://localhost:3000

# Cloudinary for image uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# SMTP for verification/password-reset emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Connectrix <no-reply@example.com>